{
    "agent_name": "Aegis",
    "agent_title": "Companion",

    "model": {
        "chat": "qwen3:8b",
        "summary": "qwen3:8b",
        "fact_extraction": "qwen3:8b",
        "embedding": "default"
    },

    "paths": {
        "data_root": "data",
        "session_journals": "data/session_journals",
        "conversation_logs": "data/conversation_logs",
        "user_profiles": "data/user_profiles",
        "knowledge_base": "data/knowledge_base",
        "security_protocols": "data/security_protocols",
        "personality_prompt": "core/personality/core_directives.txt",
        "voice_reference": "data/voice_reference"
    },

    "packs": {
        "active_personality": "pike",
        "active_voice": "pike",
        "active_theme": "lcars",
        "pack_directory": "packs"
    },

    "memory": {
        "max_context_messages": 20,
        "summary_after_messages": 30,
        "max_search_results": 5,
        "auto_extract_facts": true,
        "auto_summarize": true
    },

    "security": {
        "user_data_classified": true,
        "require_authorization_for_sharing": true,
        "log_access_attempts": true
    },

    "voice": {
        "tts": {
            "enabled": true,
            "model": "tts_models/multilingual/multi-dataset/xtts_v2",
            "device": "cuda",
            "sample_rate": 24000
        },
        "stt": {
            "enabled": true,
            "model": "base.en",
            "device": "cuda",
            "compute_type": "float16",
            "silence_timeout": 2.0,
            "input_mode": "text"
        },
        "telegram": {
            "voice_replies": true,
            "voice_char_cap": 600,
            "max_duration": 300
        }
    },

    "emotion": {
        "enabled": true,
        "model": "bhadresh-savani/distilbert-base-uncased-emotion",
        "threshold": 0.75
    },

    "web": {
        "enabled": true,
        "search_max_results": 5,
        "fetch_max_chars": 1500,
        "request_timeout": 10,
        "auto_detect": true
    },

    "google": {
        "enabled": true,
        "calendar_injection": true,
        "email_injection": true,
        "cache_ttl_seconds": 300
    },

    "operations": {
        "spellcheck_titles": true,
        "spellcheck_whitelist": [
            "aegis", "pike", "switch", "krunch", "tyler", "milo",
            "rb", "ffl", "mcp", "reel", "ballistics", "obsidian",
            "dustin", "lange", "cennymail",
            "ollama", "qwen", "lcars",
            "krunchy", "puppychat", "bluray", "fursuit", "fursuits"
        ]
    },

    "llm_router": {
        "cloud_enabled": false,
        "cloud_opt_in_features": [],
        "cloud_model": "claude-opus-4-8",
        "cloud_max_tokens": 2048
    },

    "tooling": {
        "wishlist_path": ""
    }
}
